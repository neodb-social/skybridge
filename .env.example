# Copy to .env and edit: cp .env.example .env
# All settings are optional; see README "Configuration".

# Public host of this relay — the single source of identity for actor ids,
# webfinger, object URLs. REQUIRED for anything beyond local testing.
SKYBRIDGE_DOMAIN=bridge.example.social

# URL scheme: https by default (http when SKYBRIDGE_DOMAIN is localhost).
#SKYBRIDGE_SCHEME=https

# Host port docker compose publishes the server on, default 8000.
#SKYBRIDGE_PORT=8000

# Folder for all mutable state (SQLite DB + relay key), default ./data.
# Under docker compose this is the HOST folder bind-mounted into the
# container (inside the container the data dir is always /data).
#SKYBRIDGE_DATA=./data

# Jetstream WebSocket endpoint. Defaults to the public v2 us-east instance.
# A v1 endpoint (wss://jetstream2.us-east.bsky.network/subscribe) still works,
# but historical import and collection discovery are v2-only features.
#SKYBRIDGE_JETSTREAM=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents

# Jetstream v2 archive key, for importing history (Network Replay).
# NOT needed for normal operation: the live WebSocket requires no key and is
# not metered. Only the HTTP archive endpoints are authenticated, and they are
# billed by bytes downloaded — estimate before running a large import.
# Create one at https://bsky.network/account
#SKYBRIDGE_JETSTREAM_API_KEY=gk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma/space-separated operators: accounts that get an admin panel on
# /optout after signing in (archive import controls + ingest status).
# Entries may be DIDs or handles; authorisation always compares the
# OAuth-verified DID. PREFER DIDs — an atproto handle is transferable, so
# naming an admin by handle grants access to whoever holds that handle.
#SKYBRIDGE_ADMINS=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx

# Service actor signing key — REQUIRED (startup fails without it). Either set
# the PEM here (generate with:
#   printf 'SKYBRIDGE_RELAY_KEY="%s"\n' \
#     "$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048)" >> .env
# ) or place a PEM file at SKYBRIDGE_DATA/relay_key.pem. Keep it safe:
# losing it changes the server's AP identity.
#SKYBRIDGE_RELAY_KEY=

# Comma/space-separated relay inbox URLs to publish through (Mastodon-style).
# SKYBRIDGE_RELAYS=https://relay.example/inbox

# Set to 1 to ingest live popfeed activity inside `serve` (recommended for a
# real deployment; unset = serve existing data only).
SKYBRIDGE_INGEST=1

# "Import recent activity" (user-triggered backfill on /optout): fetch at
# most this many records total from the account's PDS, and re-publish only
# those written within the last N days.
#SKYBRIDGE_BACKFILL_LIMIT=1000
#SKYBRIDGE_BACKFILL_DAYS=7

# Log level (DEBUG, INFO, WARNING, ...).
#SKYBRIDGE_LOG=INFO

# Optional: Sentry error tracking + ingest metrics (unset = telemetry off)
# SKYBRIDGE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
